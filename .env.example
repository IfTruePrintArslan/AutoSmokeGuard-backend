# Copy this file to .env and fill in real values.
# .env is gitignored — never commit it with real secrets.
# Every variable here is optional: the defaults in config/settings.py are
# development-safe, so a fresh clone runs with no .env at all.

# ---------------------------------------------------------------------------
# Core Django
# ---------------------------------------------------------------------------

# Django secret key — generate a strong random value for production.
# Example: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=replace-me-with-a-real-secret-key

# Set to False in production. Only the exact string "True" enables debug mode.
DEBUG=True

# Comma-separated list of allowed hostnames (no spaces).
# Example for production: ALLOWED_HOSTS=api.yourdomain.com
ALLOWED_HOSTS=127.0.0.1,localhost

# ---------------------------------------------------------------------------
# Front end / CORS
# ---------------------------------------------------------------------------

# Comma-separated origins allowed to call the API from a browser.
# Defaults to the Vite dev server (5173) and preview server (4173).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------

# Leave unset to use SQLite at backend/db.sqlite3.
# Set a postgres:// or postgresql:// URL to switch to PostgreSQL:
# DATABASE_URL=postgresql://asg:secret@localhost:5432/autosmokeguard
DATABASE_URL=

# Seconds to keep a PostgreSQL connection alive between requests.
# DB_CONN_MAX_AGE=60

# ---------------------------------------------------------------------------
# AutoSmokeGuard pipeline
# ---------------------------------------------------------------------------

# Size of the background analysis worker pool.
ASG_WORKER_THREADS=2

# Set to False to accept uploads but never start processing (useful in CI).
ASG_WORKER_ENABLED=True

# Boot-time upload ceiling in megabytes. Administrators can change the live
# value at runtime from the system-configuration screen (UC-09).
ASG_MAX_UPLOAD_MB=512

# ---------------------------------------------------------------------------
# HTTPS hardening (only read when DEBUG=False)
# ---------------------------------------------------------------------------

# SECURE_SSL_REDIRECT=True
# SECURE_HSTS_SECONDS=31536000
# SESSION_COOKIE_SECURE=True
# CSRF_COOKIE_SECURE=True
