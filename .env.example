# Copy this file to .env and fill in real values.
# .env is gitignored — never commit it with real secrets.

# Django secret key — generate a strong random value for production.
# Example: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=replace-me-with-a-real-secret-key

# Set to False in production.
DEBUG=True

# Comma-separated list of allowed hostnames (no spaces).
# Example for production: ALLOWED_HOSTS=api.yourdomain.com
ALLOWED_HOSTS=127.0.0.1,localhost
