# --- python ----------------------------------------------------------------
__pycache__/
*.py[cod]
*.pyc
*.egg-info/

# --- virtual environments --------------------------------------------------
venv/
.venv/
env/

# --- django ----------------------------------------------------------------
db.sqlite3
db.sqlite3-journal
# WAL sidecars — the SQLite branch of settings.py runs in journal_mode=WAL,
# which keeps a '-wal' log and a '-shm' index next to the database file.
db.sqlite3-wal
db.sqlite3-shm
# Local test databases (settings.DATABASES['default']['TEST']['NAME'] normally
# lives in the OS temp dir, but ASG_TEST_DB_NAME can point it here).
test_db*.sqlite3
test_db*.sqlite3-wal
test_db*.sqlite3-shm
/staticfiles/
/media/
/logs/

# --- environment -----------------------------------------------------------
.env
.env.*
!.env.example

# --- TLS key material ------------------------------------------------------
# scripts/generate-dev-certs.sh writes a self-signed certificate and key for
# local HTTPS testing (DEPLOYMENT.md §7). Its default output directory is
# <project root>/certs, which sits *outside* this repository — backend/ and
# frontend/ are separate git worktrees and the project root is not itself a
# repo, so nothing there is tracked in the first place. These patterns cover
# the case where CERT_DIR is pointed inside this tree, and the case where the
# two trees are ever merged into one repository.
certs/
*.pem
*.key
*.crt
*.p12
*.pfx

# --- tests / coverage ------------------------------------------------------
.pytest_cache/
htmlcov/
.coverage
.coverage.*
coverage.xml

# --- ml assets -------------------------------------------------------------
# Model weights (*.pt) ARE tracked — the app cannot start without them.
# Training data and training run outputs are not.
ml_assets/datasets/
ml_assets/runs/

# --- os / editor -----------------------------------------------------------
.DS_Store
.vscode/
.idea/
*.log

# Real-data evaluation artefacts (regenerable; contains third-party imagery
# of unverified licence — must never be committed).
ml_assets/eval_real/

# Previous model checkpoint (not lost; recoverable from git history via
# git show f7ed668:ml_assets/smoke_unet.pt > ml_assets/smoke_unet.prev.pt).
ml_assets/smoke_unet.*.pt

# --- experiment checkpoints (added for licensing/housekeeping pass, 2026-09-27) --
# Explicit, product-file-safe quarantine for training-experiment checkpoints
# under ml_assets/, so future retrains don't accidentally get committed.
# The rule above (ml_assets/smoke_unet.*.pt) already matches every
# candidate-checkpoint filename found in this tree (they are all named
# smoke_unet.<suffix>.pt) and does NOT match the three shipped product
# files below, because none of those three has a second '.' before '.pt'.
# This block restates that intent as its own explicit, self-documenting
# rule (harmless overlap with the rule above) and is written broadly
# enough to also catch differently-prefixed candidate names
# (yolo11n.candidate*.pt, yolov8n.candidate*.pt), which the rule above
# would not catch, should those ever appear.
ml_assets/*candidate*.pt
!ml_assets/smoke_unet.pt
!ml_assets/yolo11n.pt
!ml_assets/yolov8n.pt
